{
  "entities": {
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Trusted administrator marker document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account and role mapping.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["ADMIN", "HR", "MANAGER", "EMPLOYEE"]
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "name", "role", "employeeId", "createdAt", "updatedAt"]
    },
    "EmployeeRecord": {
      "title": "EmployeeRecord",
      "description": "Core employee record in the HRMS directory.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "managerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "designation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Probation", "OnNotice", "Inactive"]
        },
        "payloadJson": {
          "type": "string",
          "minLength": 2,
          "maxLength": 8000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "uid", "managerUid", "fullName", "designation", "department", "status", "payloadJson", "createdAt", "updatedAt"]
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
      "description": "Employee leave application and approval workflow state.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "managerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "leaveType": {
          "type": "string",
          "enum": ["Casual", "Sick", "Earned", "Unpaid"]
        },
        "startDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10
        },
        "endDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10
        },
        "days": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Approved", "Rejected"]
        },
        "decisionNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "uid", "managerUid", "employeeId", "leaveType", "startDate", "endDate", "days", "reason", "status", "decisionNote", "createdAt", "updatedAt"]
    },
    "ConsiderationRequest": {
      "title": "ConsiderationRequest",
      "description": "Attendance and payroll consideration request submitted by employee or manager.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "managerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Approved", "Rejected"]
        },
        "decisionNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "uid", "managerUid", "employeeId", "date", "type", "reason", "status", "decisionNote", "createdAt", "updatedAt"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Immutable system activity and audit log record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "targetRecord": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "actorUid", "actorName", "action", "module", "targetRecord", "createdAt"]
    },
    "RoleDefinition": {
      "title": "RoleDefinition",
      "description": "Custom or system role definition managed by Admin.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "baseRole": {
          "type": "string",
          "enum": ["ADMIN", "HR", "MANAGER", "EMPLOYEE"]
        },
        "isSystemRole": {
          "type": "boolean"
        },
        "payloadJson": {
          "type": "string",
          "minLength": 2,
          "maxLength": 15000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "baseRole", "isSystemRole", "payloadJson", "createdAt", "updatedAt"]
    },
    "BirthdayCelebration": {
      "title": "BirthdayCelebration",
      "description": "Team birthday or celebration calendar entry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10
        },
        "payloadJson": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "employeeId", "title", "date", "payloadJson", "createdAt", "updatedAt"]
    },
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Transient connectivity test document.",
      "type": "object",
      "properties": {
        "connected": {
          "type": "boolean"
        }
      }
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Trusted administrator UIDs."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User authentication profiles and role assignments."
    },
    "/roles/{roleId}": {
      "schema": { "$ref": "#/entities/RoleDefinition" },
      "description": "Role and access management definitions."
    },
    "/birthdays/{birthdayId}": {
      "schema": { "$ref": "#/entities/BirthdayCelebration" },
      "description": "Team birthday and celebration records."
    },
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/EmployeeRecord" },
      "description": "Company employee directory records."
    },
    "/leaves/{leaveId}": {
      "schema": { "$ref": "#/entities/LeaveRequest" },
      "description": "Leave requests and approval workflow."
    },
    "/considerations/{considerationId}": {
      "schema": { "$ref": "#/entities/ConsiderationRequest" },
      "description": "Attendance and payroll consideration requests."
    },
    "/activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogEntry" },
      "description": "Immutable audit trail of system actions."
    },
    "/test/{testId}": {
      "schema": { "$ref": "#/entities/ConnectionTest" },
      "description": "Transient connectivity check endpoint."
    }
  }
}
